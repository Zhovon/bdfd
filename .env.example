# =============================================================================
# Officers' Welfare & Community Portal — environment variables
# Copy to `.env` for local dev, or paste into Vercel / Coolify for production.
# Never commit a filled-in .env (it's gitignored). This template is safe.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Local dev: the docker Postgres from docker-compose.yml (no TLS).
# Production on Supabase: use the POOLED connection string (Supavisor,
#   port 6543, "Transaction" mode) — serverless needs the pooler, not 5432.
#   postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# TLS is enabled automatically for any non-local host.
DATABASE_URL="postgresql://annapurna:annapurna_dev@localhost:5433/annapurna?schema=public"

# --- App URL & session -------------------------------------------------------
# APP_URL builds links in emails (password reset) — set to the deployed URL.
# In production start with the vercel.app URL, then switch to the custom domain.
APP_URL="http://localhost:3000"
# Signs the login session cookie. Generate: openssl rand -hex 32
SESSION_SECRET="dev-session-secret-change-me-please-0123456789"

# --- Bootstrap admin ---------------------------------------------------------
# Seeded on first run if no admin exists. Change before deploying.
ADMIN_EMAIL="admin@portal.gov.bd"
ADMIN_PASSWORD="admin-change-me"

# --- Captcha (Cloudflare Turnstile) ------------------------------------------
# These are Cloudflare's public TEST keys — they always pass, fine for dev.
# Replace both with real keys from dash.cloudflare.com before deploying, and
# add your deployed domain(s) to the Turnstile widget's allowed hostnames.
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# --- Email (Resend over SMTP) ------------------------------------------------
# If SMTP_HOST is unset, emails are logged to the server console (dev only).
# Resend provides an SMTP relay, so no code change is needed:
#   host smtp.resend.com · user "resend" · pass = your Resend API key.
# MAIL_FROM must be on a domain you've verified in Resend (SPF/DKIM in DNS).
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="587"
# SMTP_USER="resend"
# SMTP_PASS="re_your_resend_api_key"
# MAIL_FROM="Officers' Portal <no-reply@yourdomain>"

# --- Image storage (Cloudflare R2, S3-compatible) ----------------------------
# If all five are set, uploads go to R2; otherwise they fall back to local disk
# (dev only). REQUIRED in production — Vercel's filesystem is read-only, and a
# VPS container's disk is wiped on redeploy.
#   R2_ACCOUNT_ID        Cloudflare account ID (R2 dashboard)
#   R2_ACCESS_KEY_ID     R2 API token access key
#   R2_SECRET_ACCESS_KEY R2 API token secret
#   R2_BUCKET            bucket name, e.g. welfare-portal
#   R2_PUBLIC_URL        public base URL: the r2.dev URL or a custom domain
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_URL="https://images.yourdomain"
